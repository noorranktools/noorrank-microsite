---
import { beliefs, founders } from "../data/site";
---

<section id="who" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Who We Are</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Founded on two stubborn beliefs.
    </h2>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        beliefs.map((b) => (
          <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
            <span class="font-mono text-sm text-signal-dim">{b.n}</span>
            <h3 class="mt-4 text-2xl font-semibold text-bone-50">{b.title}</h3>
            <p class="mt-4 leading-relaxed text-bone-300 print-muted">{b.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16">
      <p class="reveal text-lg font-medium text-bone-100">
        Led by the founders. Directly.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          founders.map((f) => (
            <div class="reveal flex gap-5 rounded-2xl border border-bone-500/15 bg-ink-800 p-7 print-card">
              <div
                class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-signal/15 font-mono text-lg font-semibold text-signal"
                aria-hidden="true"
              >
                {f.name[0]}
              </div>
              <div>
                <h3 class="text-xl font-semibold text-bone-50">{f.name}</h3>
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-bone-500">
                  {f.role}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-bone-300 print-muted">
                  {f.bio}
                </p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="reveal mt-8 text-bone-300 print-muted">
        We don't resell. We build. And we treat every client as a partner —
        never a revenue line.
      </p>
    </div>
  </div>
</section>
