---
import { beliefs, founders } from "../data/site";
import Slide from "./Slide.astro";

const belief = beliefs[0];
---

<Slide id="who">
  <div class="grid gap-8 md:grid-cols-2 md:items-center">
    <div>
      <p class="eyebrow reveal">Who We Are</p>
      <h2 class="d-title reveal mt-4 font-bold tracking-tight">
        Founded on one stubborn belief.
      </h2>
      <h3 class="d-h3 reveal mt-6 font-semibold text-bone-50">{belief.title}</h3>
      <p class="d-lead reveal mt-2 text-bone-300 print-muted">{belief.body}</p>
    </div>

    <div>
      <p class="d-h3 reveal font-medium text-bone-100">Led by the founders. Directly.</p>
      <div class="mt-4 grid gap-4">
        {
          founders.map((f) => (
            <div class="reveal flex gap-4 rounded-2xl border border-bone-500/15 bg-ink-800 p-5 print-card">
              <div
                class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-signal/15 font-mono text-lg font-semibold text-signal"
                aria-hidden="true"
              >
                {f.name[0]}
              </div>
              <div>
                <h3 class="d-h3 font-semibold text-bone-50">{f.name}</h3>
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-bone-500">
                  {f.role}
                </p>
                <p class="d-body mt-2 text-bone-300 print-muted">{f.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="d-body reveal mt-4 text-bone-300 print-muted">
        We don't resell. We build. And we treat every client as a partner —
        never a revenue line.
      </p>
    </div>
  </div>
</Slide>
