---
import { clients } from "../data/site";
import Slide from "./Slide.astro";
---

<Slide id="clients">
  <p class="eyebrow reveal">Who We Work With</p>
  <h2 class="d-title reveal mt-4 max-w-[30ch] font-bold tracking-tight">
    Clients across the UAE, India, the UK and South Korea.
  </h2>

  <div class="reveal mt-6 overflow-hidden rounded-2xl border border-bone-500/15">
    <table class="d-body w-full border-collapse text-left">
      <thead class="hidden md:table-header-group">
        <tr class="bg-ink-700">
          <th class="p-4 font-medium text-bone-500">Client</th>
          <th class="p-4 font-medium text-bone-500">Where</th>
          <th class="p-4 font-medium text-bone-500">What we do for them</th>
        </tr>
      </thead>
      <tbody>
        {
          clients.map((c) => (
            <tr class="block border-t border-bone-500/10 p-5 odd:bg-ink-800/40 first:border-t-0 md:table-row md:p-0 md:first:border-t">
              <th scope="row" class="block font-semibold text-bone-50 md:table-cell md:p-4">
                {c.name}
              </th>
              <td class="mt-1 block text-bone-500 md:mt-0 md:table-cell md:p-4 md:text-bone-300 print-muted">
                {c.where}
              </td>
              <td class="mt-2 block text-bone-300 md:mt-0 md:table-cell md:p-4 print-muted">
                {c.work}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Slide>
