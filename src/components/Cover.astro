---
import { founders } from "../data/site";

const presenters = founders.map((f) => f.name).join(" & ");
---

<section
  id="cover"
  class="print-cover flex min-h-[100svh] flex-col items-center justify-center bg-ink-700 px-4 py-8 md:px-10 deck:snap-start"
  aria-label="NoorRank company profile cover"
>
  <div
    class="cover-wrap flex w-full flex-col gap-4"
    style="width: min(100%, 76rem, calc((100svh - 15rem) * 16 / 9));"
  >
    <div
      class="slide flex aspect-[3/4] flex-col justify-between rounded-xl border border-bone-500/25 bg-black shadow-2xl shadow-black/60 md:aspect-video"
      style="container-type: inline-size; padding: clamp(1.25rem, 4cqw, 3.5rem);"
    >
      <div
        class="flex items-center justify-between gap-4 border-b border-bone-500/20 pb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-bone-500 sm:text-xs"
      >
        <span class="text-sm normal-case tracking-tight text-bone-50">
          Noor<span class="text-signal">Rank</span>
        </span>
        <span>Company Profile · September 2026</span>
      </div>

      <div>
        <h2
          class="text-5xl font-extrabold leading-[0.98] tracking-tightest md:text-7xl"
          style="font-size: clamp(2.25rem, 8.5cqw, 7rem);"
        >
          Expected a deck?
        </h2>
        <p
          class="mt-4 text-lg text-bone-300 print-muted"
          style="font-size: clamp(1rem, 2.4cqw, 1.75rem);"
        >
          This company profile is a website, on purpose.
        </p>
      </div>

      <div
        class="flex items-end justify-between gap-4 border-t border-bone-500/20 pt-3 font-mono text-[11px] text-bone-500 sm:text-xs"
      >
        <span>Presented by {presenters}, Founders · Dubai · Kochi</span>
        <span class="text-bone-50">01</span>
      </div>
    </div>

    <div
      class="cover-extras rounded-lg border border-bone-500/15 bg-ink-800 px-4 py-3 text-sm leading-relaxed text-bone-300 print-muted"
    >
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-bone-500">Notes</p>
      <p class="mt-1">
        AI engines can't read a deck sitting in an inbox. They can read a
        website, and that's where your customers are now looking. This is our
        company profile; our main website is
        <a
          href="https://noorrank.com"
          class="text-bone-50 underline underline-offset-4 hover:text-signal"
          rel="noopener">noorrank.com →</a
        >
      </p>
    </div>

    <div class="cover-extras no-print flex flex-wrap items-center gap-4">
      <a
        href="#top"
        class="inline-block rounded-full bg-signal px-6 py-3 text-sm font-semibold text-ink-900 transition-opacity hover:opacity-90"
      >
        Next slide ↓
      </a>
      <span class="hidden deck:inline-flex">
        <button
          id="present-btn"
          type="button"
          hidden
          title="Present full screen (F)"
          class="rounded-full border border-bone-500/30 px-6 py-3 text-sm font-medium text-bone-100 transition-colors hover:border-bone-300"
        >
          Present ⛶
        </button>
      </span>
      <span class="font-mono text-xs text-bone-500">or scroll · press space</span>
    </div>
  </div>
</section>

<script>
  // Presentation mode: full screen, one slide per key press. Optional
  // enhancement only; the page reads the same without it.
  const root = document.documentElement;
  const btn = document.getElementById("present-btn");
  const canPresent = document.fullscreenEnabled;
  if (btn && canPresent) btn.hidden = false;

  const slides = () =>
    [document.getElementById("cover"), ...document.querySelectorAll(".deck-slide")].filter(
      Boolean
    ) as HTMLElement[];

  const currentIndex = () => {
    let best = 0;
    let bestDist = Infinity;
    slides().forEach((s, i) => {
      const d = Math.abs(s.getBoundingClientRect().top);
      if (d < bestDist) {
        bestDist = d;
        best = i;
      }
    });
    return best;
  };

  // Remember the last target briefly so fast key presses step one slide each.
  let lastTarget = 0;
  let lastGoAt = 0;
  const go = (i: number, smooth = true) => {
    const list = slides();
    lastTarget = Math.max(0, Math.min(list.length - 1, i));
    lastGoAt = Date.now();
    list[lastTarget].scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
  };
  const base = () => (Date.now() - lastGoAt < 700 ? lastTarget : currentIndex());

  const toggle = () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else root.requestFullscreen();
  };

  btn?.addEventListener("click", toggle);

  document.addEventListener("fullscreenchange", () => {
    const i = currentIndex();
    root.classList.toggle("presenting", !!document.fullscreenElement);
    requestAnimationFrame(() => go(i, false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === "f" || e.key === "F") {
      if (!canPresent) return;
      e.preventDefault();
      toggle();
      return;
    }
    if (!root.classList.contains("presenting")) return;
    if (["ArrowDown", "ArrowRight", "PageDown", " "].includes(e.key)) {
      e.preventDefault();
      go(base() + 1);
    } else if (["ArrowUp", "ArrowLeft", "PageUp"].includes(e.key)) {
      e.preventDefault();
      go(base() - 1);
    } else if (e.key === "Home") {
      e.preventDefault();
      go(0);
    } else if (e.key === "End") {
      e.preventDefault();
      go(slides().length - 1);
    }
  });
</script>
