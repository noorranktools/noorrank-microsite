---
import { site } from "../data/site";
import Slide from "./Slide.astro";
---

<Slide id="contact">
  <p class="eyebrow reveal">Start with a Conversation</p>
  <h2 class="d-display reveal mt-4 text-balance font-extrabold tracking-tightest">
    See what AI says <span class="text-bone-300">about you.</span>
  </h2>

  <div class="mt-8 grid gap-6 md:grid-cols-2 md:items-start">
    <div>
      <p class="d-lead reveal text-bone-300 print-muted">
        Tell us your business and three questions your customers ask. We'll put
        them to ChatGPT, Perplexity and Gemini and send you what comes back:
        where you're named, and where you're not. No pitch deck.
      </p>
      <a
        href={`mailto:${site.email}?subject=AI%20visibility%20check`}
        class="reveal mt-6 inline-block rounded-full bg-signal px-7 py-3.5 text-sm font-semibold text-ink-900 transition-opacity hover:opacity-90"
      >
        Send us your three questions
      </a>
    </div>

    <div
      class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 font-mono text-sm print-card"
    >
      <div class="flex items-center gap-2 text-bone-500" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-bone-500/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-bone-500/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-bone-500/40"></span>
      </div>
      <div class="mt-5 space-y-2">
        <p>
          <span class="text-signal-dim">→</span> email
          <span class="text-bone-500">·</span>
          <a
            href={`mailto:${site.email}`}
            class="text-bone-50 underline-offset-4 hover:underline">{site.email}</a
          >
        </p>
        <p>
          <span class="text-signal-dim">→</span> web
          <span class="text-bone-500">·</span>
          <a
            href={`https://${site.url.replace("https://", "")}`}
            class="text-bone-50 underline-offset-4 hover:underline"
            rel="noopener">noorrank.com</a
          >
        </p>
        <p>
          <span class="text-signal-dim">→</span> base
          <span class="text-bone-500">·</span>
          <span class="text-bone-50">{site.location} · Worldwide</span>
        </p>
      </div>
    </div>
  </div>

  <p class="mt-8 font-mono text-xs uppercase tracking-[0.3em] text-bone-500">
    Rank by Design, Not by Chance
  </p>
</Slide>
