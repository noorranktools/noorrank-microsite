---
import { nura } from "../data/site";
import Slide from "./Slide.astro";
---

<Slide id="proof">
  <p class="eyebrow reveal">Our Work · Case Study</p>
  <div class="reveal mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <h2 class="d-title font-bold tracking-tight">{nura.name}</h2>
    <span
      class="rounded-full border border-signal/30 px-3 py-1 font-mono text-[11px] uppercase tracking-wide text-signal-dim"
    >
      {nura.type}
    </span>
  </div>
  <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-bone-500">
    {nura.tag}
  </p>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 print-card">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-bone-500">Before</p>
      <p class="d-lead mt-3 text-bone-300 print-muted">{nura.before}</p>
    </div>
    <div class="reveal rounded-2xl border border-signal/30 bg-ink-800 p-6 print-card">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-signal-dim">Now</p>
      <p class="d-lead mt-3 text-bone-100 print-muted">{nura.after}</p>
    </div>
  </div>
</Slide>

<Slide id="nura-results">
  <p class="eyebrow reveal">Our Work · Results</p>
  <h2 class="d-title reveal mt-4 max-w-[34ch] font-bold tracking-tight">
    "{nura.query}"
  </h2>
  <p class="d-lead reveal mt-4 max-w-[70ch] text-bone-300 print-muted">
    {nura.queryResult}
  </p>

  <dl
    class="reveal mt-8 grid gap-px overflow-hidden rounded-2xl border border-bone-500/15 bg-bone-500/10 md:grid-cols-3"
  >
    {
      nura.stats.map((s) => (
        <div class="bg-ink-800 p-5">
          <dt class="d-body text-bone-500">{s.label}</dt>
          <dd class="d-stat mt-2 font-semibold text-signal">{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="reveal mt-6 flex flex-wrap items-center justify-between gap-4">
    <p class="font-mono text-xs text-bone-500">{nura.note}</p>
    <a
      href="/nura/"
      class="inline-block rounded-full border border-bone-500/25 px-5 py-2.5 text-sm font-medium text-bone-100 transition-colors hover:border-bone-300"
    >
      Read the full case study →
    </a>
  </div>
</Slide>
