---
import { work } from "../data/site";
---

<section id="work" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Our Work</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Proof, not promises.
    </h2>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        work.map((w) => (
          <article class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-bone-500">
              {w.tag}
            </p>
            <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-2xl font-semibold text-bone-50">{w.name}</h3>
              <span class="rounded-full border border-signal/30 px-3 py-1 font-mono text-[11px] uppercase tracking-wide text-signal-dim">
                {w.type}
              </span>
            </div>
            <p class="mt-4 leading-relaxed text-bone-300 print-muted">{w.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
