---
import { nura } from "../data/site";
---

<section id="proof" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Our Work</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Proof, not promises.
    </h2>

    <article class="reveal mt-14 rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card md:p-10">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-bone-500">
        {nura.tag}
      </p>
      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-2xl font-semibold text-bone-50 sm:text-3xl">{nura.name}</h3>
        <span class="rounded-full border border-signal/30 px-3 py-1 font-mono text-[11px] uppercase tracking-wide text-signal-dim">
          {nura.type}
        </span>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-bone-500/15 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-bone-500">Before</p>
          <p class="mt-3 leading-relaxed text-bone-300 print-muted">{nura.before}</p>
        </div>
        <div class="rounded-xl border border-signal/30 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-signal-dim">Now</p>
          <p class="mt-3 leading-relaxed text-bone-100 print-muted">{nura.after}</p>
        </div>
      </div>

      <div class="mt-8">
        <p class="font-mono text-sm text-bone-50">"{nura.query}"</p>
        <p class="mt-2 leading-relaxed text-bone-300 print-muted">{nura.queryResult}</p>
      </div>

      <dl class="mt-8 grid gap-px overflow-hidden rounded-xl border border-bone-500/15 bg-bone-500/10 sm:grid-cols-3">
        {
          nura.stats.map((s) => (
            <div class="bg-ink-800 p-5">
              <dt class="text-xs leading-snug text-bone-500">{s.label}</dt>
              <dd class="mt-2 text-xl font-semibold text-signal">{s.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 font-mono text-xs text-bone-500">{nura.note}</p>
    </article>
  </div>
</section>
