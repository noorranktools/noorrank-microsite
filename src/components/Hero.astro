---
import { site } from "../data/site";
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.55] no-print"
    style="background:
      radial-gradient(60rem 40rem at 70% -10%, rgba(91,140,255,0.10), transparent 60%),
      radial-gradient(50rem 40rem at 10% 10%, rgba(212,255,63,0.08), transparent 55%);"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative flex min-h-[92vh] flex-col justify-center pt-28 pb-20">
    <p class="eyebrow reveal">AI Visibility · Founder-Led · Dubai</p>

    <h1
      class="reveal mt-6 max-w-5xl text-balance text-5xl font-extrabold leading-[0.98] tracking-tightest sm:text-7xl lg:text-[5.5rem]"
    >
      Make AI recommend your business<br />
      <span class="text-bone-300">to the right customers.</span>
    </h1>

    <p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-bone-300 print-muted">
      NoorRank is a Dubai-based AI visibility consultancy. When people ask
      ChatGPT, Perplexity, Gemini or Claude for a business like yours, we fix
      what those engines read about you, so they can name you and get the
      facts right.
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="rounded-full bg-signal px-6 py-3 text-sm font-semibold text-ink-900 transition-opacity hover:opacity-90"
      >
        See what AI says about you
      </a>
      <a
        href="#proof"
        class="rounded-full border border-bone-500/25 px-6 py-3 text-sm font-medium text-bone-100 transition-colors hover:border-bone-300"
      >
        See the proof →
      </a>
    </div>

    <div
      class="reveal mt-16 flex flex-wrap items-center gap-x-8 gap-y-2 font-mono text-xs text-bone-500"
    >
      <span>{site.tagline}</span>
      <span class="hidden sm:inline">·</span>
      <span>Aakarsh &amp; Devika</span>
      <span class="hidden sm:inline">·</span>
      <span>{site.location} · {site.reach}</span>
    </div>
  </div>
</section>
