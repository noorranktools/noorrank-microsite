---
import { miracleBerry as mb } from "../data/site";
import Slide from "./Slide.astro";

// Build an SVG sparkline path from the experiment's real day/state data.
// y-values encode the narrative: rising recognition, the Day-19 drop, recovery.
const heights: Record<string, number> = { up: 0.62, down: 0.18, peak: 0.92 };
const W = 760;
const H = 220;
const padX = 40;
const padY = 28;
const pts = mb.timeline.map((t, i) => {
  const x = padX + (i * (W - padX * 2)) / (mb.timeline.length - 1);
  const y = H - padY - heights[t.state] * (H - padY * 2);
  return { x, y, ...t };
});
const linePath = pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
const areaPath = `${linePath} L${pts[pts.length - 1].x.toFixed(1)},${H - padY} L${pts[0].x.toFixed(1)},${H - padY} Z`;
---

<Slide id="lab">
  <p class="eyebrow reveal">Our Own Lab</p>
  <h2 class="d-title reveal mt-4 font-bold tracking-tight">{mb.title}</h2>
  <p class="d-lead reveal mt-3 max-w-[70ch] text-bone-300 print-muted">
    {mb.subtitle}
  </p>

  <div class="mt-6 grid gap-6 md:grid-cols-5 md:items-center">
    <figure
      class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-4 print-card md:col-span-3"
    >
      <svg
        id="mb-graph"
        viewBox={`0 0 ${W} ${H}`}
        class="w-full"
        role="img"
        aria-label="A line chart of AI citation recognition across 21 days: rising through Day 17, a sharp drop on Day 19, then recovery to a peak on Day 21."
      >
        <defs>
          <linearGradient id="mbFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#d4ff3f" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#d4ff3f" stop-opacity="0" />
          </linearGradient>
        </defs>
        <line x1={padX} y1={H - padY} x2={W - padX} y2={H - padY} stroke="#3a3a48" stroke-width="1" />
        <path class="mb-area" d={areaPath} fill="url(#mbFill)" opacity="0" />
        <path
          class="mb-line"
          d={linePath}
          fill="none"
          stroke="#d4ff3f"
          stroke-width="2.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        {
          pts.map((p) => (
            <g class="mb-node" opacity="0">
              <circle
                cx={p.x}
                cy={p.y}
                r={p.state === "peak" ? 6 : 4}
                fill={p.state === "down" ? "#5b8cff" : "#d4ff3f"}
              />
              <text
                x={p.x}
                y={H - 8}
                text-anchor="middle"
                fill="#8f8a7c"
                font-size="11"
                font-family="monospace"
              >
                Day {p.day}
              </text>
            </g>
          ))
        }
      </svg>
    </figure>

    <ol class="grid gap-2 md:col-span-2">
      {
        mb.timeline.map((t) => (
          <li class="d-body flex gap-3">
            <span
              class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${
                t.state === "down" ? "bg-accent" : "bg-signal"
              }`}
              aria-hidden="true"
            />
            <span class="text-bone-300 print-muted">
              <span class="font-mono text-bone-50">Day {t.day}</span> — {t.label}
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="reveal mt-6 font-mono text-xs text-bone-500">
    Open Research · <a
      href="https://noorranklabs.com"
      class="text-signal-dim underline-offset-4 hover:underline"
      rel="noopener">noorranklabs.com</a
    > · All data, code &amp; findings publicly documented
  </p>
</Slide>

<Slide id="lab-lessons">
  <p class="eyebrow reveal">Our Own Lab · What We Learned</p>
  <h2 class="d-title reveal mt-4 font-bold tracking-tight">
    Three lessons from 21 days.
  </h2>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {
      mb.lessons.map((l) => (
        <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 print-card">
          <span class="font-mono text-sm text-signal-dim">{l.n}</span>
          <h3 class="d-h3 mt-3 font-semibold text-bone-50">{l.title}</h3>
          <p class="d-body mt-2 text-bone-300 print-muted">{l.body}</p>
        </div>
      ))
    }
  </div>
</Slide>

<script>
  // Draw the line on scroll-into-view. Pure presentation; data + labels are
  // already in the static SVG above.
  const svg = document.getElementById("mb-graph");
  if (svg) {
    const line = svg.querySelector(".mb-line") as SVGPathElement | null;
    const area = svg.querySelector(".mb-area") as SVGPathElement | null;
    const nodes = svg.querySelectorAll(".mb-node");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (line) {
      const len = line.getTotalLength();
      if (!reduce) {
        line.style.strokeDasharray = String(len);
        line.style.strokeDashoffset = String(len);
        line.style.transition = "stroke-dashoffset 1.6s cubic-bezier(0.16,1,0.3,1)";
      }
      const run = () => {
        if (reduce) {
          if (area) area.style.opacity = "1";
          nodes.forEach((n) => ((n as SVGElement).style.opacity = "1"));
          return;
        }
        line.style.strokeDashoffset = "0";
        if (area) {
          area.style.transition = "opacity 1s ease 0.6s";
          area.style.opacity = "1";
        }
        nodes.forEach((n, i) => {
          const el = n as SVGElement;
          el.style.transition = "opacity 0.4s ease";
          el.style.transitionDelay = `${0.5 + i * 0.18}s`;
          requestAnimationFrame(() => (el.style.opacity = "1"));
        });
      };
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              run();
              obs.disconnect();
            }
          }
        },
        { threshold: 0.4 }
      );
      io.observe(svg);
    }
  }
</script>
