---
import { engagements } from "../data/site";

const statusTone: Record<string, string> = {
  "Results Live": "text-signal border-signal/40",
  "Engagement Active": "text-bone-50 border-bone-300/40",
  "Development Stage": "text-accent border-accent/40",
  Onboarding: "text-bone-300 border-bone-500/40",
};
---

<section id="engagements" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Active Engagements</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Six active engagements across healthcare &amp; AI.
    </h2>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        engagements.map((e) => (
          <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 print-card">
            <div class="flex items-center justify-between">
              <span class="text-2xl" aria-hidden="true">{e.flag}</span>
              <span
                class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wide ${statusTone[e.status] ?? "text-bone-300 border-bone-500/40"}`}
              >
                {e.status}
              </span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-bone-50">{e.name}</h3>
            <p class="font-mono text-xs text-bone-500">{e.meta}</p>
            <p class="mt-3 text-sm leading-relaxed text-bone-300 print-muted">
              {e.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
