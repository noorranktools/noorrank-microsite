---
const cols = [
  {
    tag: "20 Years Ago",
    title: "Human Eyes",
    body: "Every business optimised for one audience: humans. Human eyes on a search result. Human clicks. Human attention.",
  },
  {
    tag: "Today",
    title: "Machine Gatekeeper",
    body: "The first thing that meets your customer isn't a person — it's a machine. An AI model deciding what to show, what to recommend, what to leave out.",
  },
  {
    tag: "The Problem",
    title: "Machines Don't Know You",
    body: "Your brand was built to be understood by people. Nobody ever taught the machines who you are. That's why NoorRank exists.",
  },
];
---

<section id="shift" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">The Shift</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      The audience changed. The gatekeeper is now a machine.
    </h2>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-bone-500/15 bg-bone-500/10 md:grid-cols-3">
      {
        cols.map((c) => (
          <div class="reveal bg-ink-800 p-7 print-card">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-bone-500">
              {c.tag}
            </p>
            <h3 class="mt-3 text-xl font-semibold text-bone-50">{c.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-bone-300 print-muted">
              {c.body}
            </p>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 text-lg font-medium text-signal">
      So, when the machine decides — it should choose <span class="italic">you</span>.
    </p>
  </div>
</section>
