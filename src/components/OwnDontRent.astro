---
import { ownContrasts } from "../data/site";
---

<section id="own" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Own, Don't Rent</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Stop paying every month to borrow someone else's.
    </h2>

    <blockquote class="reveal mt-10 max-w-3xl border-l-2 border-signal pl-6 text-lg italic leading-relaxed text-bone-200 print-muted">
      "You don't tell an architect: 'Bricks are cheap, so my house should be
      cheap.' You pay for it to be built right — and to own it. Software is the
      same."
    </blockquote>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-bone-500/15 bg-bone-500/10">
      {
        ownContrasts.map((row) => (
          <div class="reveal grid bg-ink-800 sm:grid-cols-2">
            <div class="flex items-start gap-3 p-6">
              <span class="mt-0.5 text-bone-500" aria-hidden="true">✕</span>
              <p class="text-bone-400 line-through decoration-bone-500/40">
                {row.bad}
              </p>
            </div>
            <div class="flex items-start gap-3 border-t border-bone-500/10 p-6 sm:border-l sm:border-t-0">
              <span class="mt-0.5 text-signal" aria-hidden="true">✓</span>
              <p class="font-medium text-bone-50">{row.good}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
      <h3 class="text-xl font-semibold text-bone-50">The Retainer Difference</h3>
      <p class="mt-3 max-w-3xl leading-relaxed text-bone-300 print-muted">
        Stop paying a SaaS vendor and you lose everything. Stop working with us
        and you keep everything we built. We earn the renewal with ongoing work.
        We don't trap you in it.
      </p>
    </div>
  </div>
</section>
