---
import { visibility, alsoBuild } from "../data/site";
import Slide from "./Slide.astro";
---

<Slide id="what-we-do">
  <div class="reveal flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <p class="eyebrow">What We Do</p>
    <div class="flex flex-wrap items-center gap-2">
      <p class="mr-1 font-mono text-xs uppercase tracking-[0.16em] text-bone-500">
        Works across
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          visibility.engines.map((e) => (
            <li class="rounded-full border border-bone-500/20 px-3 py-1 font-mono text-[11px] text-bone-300">
              {e}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <h2 class="d-title reveal mt-4 max-w-[30ch] font-bold tracking-tight">
    {visibility.title}
  </h2>
  <p class="d-lead reveal mt-4 max-w-[70ch] text-bone-300 print-muted">
    {visibility.intro}
  </p>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {
      visibility.points.map((p, i) => (
        <article class="reveal flex flex-col rounded-2xl border border-bone-500/15 bg-ink-800 p-5 print-card">
          <span class="font-mono text-sm text-signal-dim">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="d-h3 mt-3 font-semibold text-bone-50">{p.title}</h3>
          <p class="d-body mt-2 text-bone-300 print-muted">{p.body}</p>
        </article>
      ))
    }
  </div>
</Slide>

<Slide id="also-build">
  <p class="eyebrow reveal">We Also Build</p>
  <h2 class="d-title reveal mt-4 max-w-[30ch] font-bold tracking-tight">
    Systems you own, and a plan for where AI fits.
  </h2>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {
      alsoBuild.map((b) => (
        <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 print-card">
          <h3 class="d-h3 font-semibold text-bone-50">{b.title}</h3>
          <p class="d-body mt-3 text-bone-300 print-muted">{b.body}</p>
        </div>
      ))
    }
  </div>
</Slide>
