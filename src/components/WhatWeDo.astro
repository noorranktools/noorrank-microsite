---
import { disciplines } from "../data/site";
---

<section id="what-we-do" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">What We Do</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Three disciplines. One roof.
    </h2>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        disciplines.map((d) => (
          <article class="reveal flex flex-col rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
            <div class="flex items-baseline justify-between">
              <span class="font-mono text-sm text-signal-dim">{d.n}</span>
            </div>
            <h3 class="mt-5 text-2xl font-semibold text-bone-50">{d.title}</h3>
            <p class="mt-1 font-mono text-xs uppercase tracking-[0.16em] text-bone-500">
              {d.kicker}
            </p>
            <p class="mt-5 flex-1 text-sm leading-relaxed text-bone-300 print-muted">
              {d.body}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {d.tags.map((t) => (
                <li class="rounded-full border border-bone-500/20 px-3 py-1 font-mono text-[11px] text-bone-300">
                  {t}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
