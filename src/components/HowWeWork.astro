---
import { process } from "../data/site";
import Slide from "./Slide.astro";
---

<Slide id="how">
  <p class="eyebrow reveal">How We Work</p>
  <h2 class="d-title reveal mt-4 max-w-[30ch] font-bold tracking-tight">
    Every AI visibility engagement runs in three stages.
  </h2>

  <ol
    class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-bone-500/15 bg-bone-500/10 md:grid-cols-3"
  >
    {
      process.map((step) => (
        <li class="reveal flex flex-col bg-ink-800 p-6 print-card">
          <span class="font-mono text-sm text-signal-dim">{step.n}</span>
          <h3 class="d-h3 mt-3 font-semibold text-bone-50">{step.title}</h3>
          <p class="d-body mt-2 text-bone-300 print-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <p class="d-body reveal mt-6 text-bone-300 print-muted">
    You work with the founders directly — not a layer of account managers.
  </p>
</Slide>
