---
import { process } from "../data/site";
---

<section id="how" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">How We Work</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Every AI visibility engagement runs in three stages.
    </h2>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-bone-500/15 bg-bone-500/10 md:grid-cols-3">
      {
        process.map((step) => (
          <li class="reveal flex flex-col bg-ink-800 p-6 print-card">
            <span class="font-mono text-sm text-signal-dim">{step.n}</span>
            <h3 class="mt-4 text-base font-semibold text-bone-50">
              {step.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-bone-300 print-muted">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-8 text-bone-300 print-muted">
      You work with the founders directly — not a layer of account managers.
    </p>
  </div>
</section>
