---
import { faqs } from "../data/site";
import Slide from "./Slide.astro";

// Three questions per slide so each fits a 16:9 slide.
const pages = [
  { id: "faq", title: "The questions we get asked most.", items: faqs.slice(0, 3) },
  { id: "faq-2", title: "More honest answers.", items: faqs.slice(3) },
];
---

{
  pages.map((p) => (
    <Slide id={p.id}>
      <p class="eyebrow reveal">Honest Answers</p>
      <h2 class="d-title reveal mt-4 font-bold tracking-tight">{p.title}</h2>
      <dl class="mt-8 grid gap-4 md:grid-cols-3">
        {p.items.map((f) => (
          <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-6 print-card">
            <dt class="d-h3 font-semibold text-bone-50">{f.q}</dt>
            <dd class="d-body mt-3 text-bone-300 print-muted">{f.a}</dd>
          </div>
        ))}
      </dl>
    </Slide>
  ))
}
