---
import { faqs } from "../data/site";
---

<section id="faq" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Honest Answers</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      The questions we get asked most.
    </h2>

    <dl class="mt-14 grid gap-6 md:grid-cols-2">
      {
        faqs.map((f) => (
          <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
            <dt class="text-lg font-semibold text-bone-50">{f.q}</dt>
            <dd class="mt-3 leading-relaxed text-bone-300 print-muted">{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
