---
import { reasons } from "../data/site";
---

<section id="why" class="border-t border-bone-500/10 py-24 md:py-32">
  <div class="wrap">
    <p class="eyebrow reveal">Why NoorRank</p>
    <h2 class="reveal mt-5 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Four reasons clients choose us.
    </h2>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        reasons.map((r, i) => (
          <div class="reveal rounded-2xl border border-bone-500/15 bg-ink-800 p-8 print-card">
            <span class="font-mono text-sm text-signal-dim">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 text-xl font-semibold text-bone-50">{r.title}</h3>
            <p class="mt-3 leading-relaxed text-bone-300 print-muted">{r.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
