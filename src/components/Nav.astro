---
const links = [
  { href: "#what-we-do", label: "What We Do" },
  { href: "#proof", label: "Proof" },
  { href: "#work", label: "Work" },
  { href: "#contact", label: "Contact" },
];
---

<header class="no-print fixed inset-x-0 top-0 z-50">
  <div class="wrap">
    <nav
      class="mt-4 flex items-center justify-between rounded-full border border-bone-500/15 bg-ink-800/70 px-5 py-2.5 backdrop-blur-md"
      aria-label="Primary"
    >
      <a href="#top" class="font-mono text-sm font-medium tracking-tight text-bone-50">
        Noor<span class="text-signal">Rank</span>
      </a>
      <ul class="hidden items-center gap-7 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-bone-300 transition-colors hover:text-bone-50"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="#contact"
        class="hidden rounded-full bg-signal px-4 py-1.5 text-sm font-semibold text-ink-900 transition-opacity hover:opacity-90 sm:inline-block"
      >
        Start a Conversation
      </a>
      <a
        href="#contact"
        class="rounded-full bg-signal px-3.5 py-1.5 text-xs font-semibold text-ink-900 sm:hidden"
        aria-label="Start a conversation"
      >
        Talk →
      </a>
    </nav>
  </div>
</header>
