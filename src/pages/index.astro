---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Shift from "../components/Shift.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import HowWeWork from "../components/HowWeWork.astro";
import OurWork from "../components/OurWork.astro";
import ProofOfConcept from "../components/ProofOfConcept.astro";
import Clients from "../components/Clients.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Shift />
    <WhatWeDo />
    <HowWeWork />
    <OurWork />
    <ProofOfConcept />
    <Clients />
    <WhoWeAre />
    <Faq />
    <Contact />
  </main>
  <footer class="border-t border-bone-500/10 py-10 no-print">
    <div class="wrap flex flex-col items-start justify-between gap-2 font-mono text-xs text-bone-500 sm:flex-row sm:items-center">
      <span>© 2026 NoorRank · Dubai, UAE</span>
      <span>Rank by Design, Not by Chance</span>
    </div>
  </footer>
</Base>
